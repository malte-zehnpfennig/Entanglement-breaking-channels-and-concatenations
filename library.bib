@article{yakymenkoContinuousZaunerConjecture2022,
  title = {On the Continuous {{Zauner}} Conjecture},
  author = {Yakymenko, Danylo},
  year = 2022,
  month = jul,
  journal = {Quantum Information and Computation},
  volume = {22},
  number = {9\&10},
  eprint = {2112.05875},
  primaryclass = {quant-ph},
  pages = {721--732},
  issn = {15337146},
  doi = {10.26421/QIC22.9-10-1},
  urldate = {2026-01-25},
  abstract = {In a recent paper by S. Pandey, V. Paulsen, J. Prakash, and M. Rahaman, the authors studied the entanglement breaking quantum channels \${$\Phi\_$}t:\textbackslash mathbb\textbraceleft C\textbraceright\textasciicircum\textbraceleft d\textbackslash times d\textbraceright{} \textbackslash to \textbackslash mathbb\textbraceleft C\textbraceright\textasciicircum\textbraceleft d \textbackslash times d\textbraceright\$ for \$t \textbackslash in [-\textbackslash frac\textbraceleft 1\textbraceright\textbraceleft d\textasciicircum 2-1\textbraceright, \textbackslash frac\textbraceleft 1\textbraceright\textbraceleft d+1\textbraceright ]\$ defined by \${$\Phi\_$}t(X) = tX+ (1-t)\textbackslash text\textbraceleft Tr\textbraceright (X) \textbackslash frac\textbraceleft 1\textbraceright\textbraceleft d\textbraceright I\$. They proved that Zauner's conjecture is equivalent to the statement that entanglement breaking rank of \${$\Phi\_$}\textbraceleft\textbackslash frac\textbraceleft 1\textbraceright\textbraceleft d+1\textbraceright\textbraceright\$ is \$d\textasciicircum 2\$. The authors made the extended conjecture that \$\textbackslash text\textbraceleft ebr\textbraceright ({$\Phi\_$}t)=d\textasciicircum 2\$ for every \$t \textbackslash in [0, \textbackslash frac\textbraceleft 1\textbraceright\textbraceleft d+1\textbraceright ]\$ and proved it in dimensions 2 and 3. In this paper we prove that for any \$t \textbackslash in [-\textbackslash frac\textbraceleft 1\textbraceright\textbraceleft d\textasciicircum 2-1\textbraceright, \textbackslash frac\textbraceleft 1\textbraceright\textbraceleft d+1\textbraceright ] \textbackslash setminus\textbackslash\textbraceleft 0\textbackslash\textbraceright\$ the equality \$\textbackslash text\textbraceleft ebr\textbraceright ({$\Phi\_$}t)=d\textasciicircum 2\$ is equivalent to the existence of a pair of informationally complete unit norm tight frames \$\textbackslash\textbraceleft\textbar x\_i\textbackslash rangle\textbackslash\textbraceright\_\textbraceleft i=1\textbraceright\textasciicircum\textbraceleft d\textasciicircum 2\textbraceright, \textbackslash\textbraceleft\textbar y\_i\textbackslash rangle\textbackslash\textbraceright\_\textbraceleft i=1\textbraceright\textasciicircum\textbraceleft d\textasciicircum 2\textbraceright\$ in \$\textbackslash mathbb\textbraceleft C\textbraceright\textasciicircum d \$ which are mutually unbiased in a certain sense. That is, for any \$i\textbackslash neq j\$ it holds that \$\textbar\textbackslash langle x\_i\textbar y\_j\textbackslash rangle\textbar\textasciicircum 2 = \textbackslash frac\textbraceleft 1-t\textbraceright\textbraceleft d\textbraceright\$ and \$\textbar\textbackslash langle x\_i\textbar y\_i\textbackslash rangle\textbar\textasciicircum 2 = \textbackslash frac\textbraceleft t(d\textasciicircum 2-1)+1\textbraceright\textbraceleft d\textbraceright\$ (also it follows that \$\textbar\textbackslash langle x\_i\textbar x\_j\textbackslash rangle\textbackslash langle y\_i\textbar y\_j\textbackslash rangle\textbar =\textbar t\textbar\$). Though, our numerical searches for solutions were not successful in dimensions 4 and 5 for values of \$t\$ other than \$0\$ or \$\textbackslash frac\textbraceleft 1\textbraceright\textbraceleft d+1\textbraceright\$.},
  archiveprefix = {arXiv},
  keywords = {Mathematical Physics,Quantum Physics},
  file = {/Users/maltezehnpfennig/Zotero/storage/KK6KBAHN/Yakymenko - 2022 - On the continuous Zauner conjecture.pdf;/Users/maltezehnpfennig/Zotero/storage/X7HGTTTF/2112.html}
}

