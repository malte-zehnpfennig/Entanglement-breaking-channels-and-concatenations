  file = {/Users/maltezehnpfennig/Zotero/storage/AVTDKLZ9/Piana and Müller-Hermes - 2025 - Annihilating and breaking Lorentz cone entanglement.pdf;/Users/maltezehnpfennig/Zotero/storage/3I24NCVS/2506.html}
